NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/attendance-system
JWT_SECRET=replace_with_a_very_secure_random_string_min_32_chars
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173

# Business rules
BUSINESS_TIMEZONE=Asia/Kolkata
STANDARD_SHIFT_MINUTES=480
WORKING_DAYS=1,2,3,4,5

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=attendance

# Geofence settings
GEOFENCE_ENABLED=false
GEOFENCE_OFFICE_LAT=28.6139
GEOFENCE_OFFICE_LNG=77.2090
GEOFENCE_RADIUS_METERS=200
GEOFENCE_MAX_ACCURACY_METERS=100

# Initial Admin Seeding
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123

# Scheduled Jobs
ENABLE_CRON=true
MISSED_PUNCH_IN_ALERT_TIME=11:00
MISSED_PUNCH_OUT_ALERT_TIME=20:00
AUTO_CLOSE_TIME=00:10

# Email & Invitations (Resend)
# EMAIL_PROVIDER: only 'resend' supported
EMAIL_PROVIDER=resend
# RESEND_API_KEY: Resend API key starting with 're_'. Must have Sending access (or Full access to inspect message status). Backend only.
RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM: verified sender or Resend sandbox (e.g. "AMS Portal <onboarding@resend.dev>")
EMAIL_FROM=AMS Portal <onboarding@resend.dev>
# EMAIL_REPLY_TO: optional reply-to email address
EMAIL_REPLY_TO=
# APP_BASE_URL: frontend base URL for building invitation links (http://localhost:5173 for local dev).
# Changing APP_BASE_URL on the backend host is how deployed links get the real domain (and CLIENT_ORIGIN must match it).
APP_BASE_URL=http://localhost:5173
# INVITATION_EXPIRY_HOURS: token expiration time in hours (default 72)
INVITATION_EXPIRY_HOURS=72
# INVITATION_RESEND_COOLDOWN_SECONDS: rate-limiting cooldown between invitation email resends (default 60)
INVITATION_RESEND_COOLDOWN_SECONDS=60
# INVITATION_MAX_RESENDS: maximum allowed resends per invitation (default 10)
INVITATION_MAX_RESENDS=10
# EMAIL_SEND_TIMEOUT_MS: timeout for provider calls in milliseconds (default 10000)
EMAIL_SEND_TIMEOUT_MS=10000
# ALLOW_PUBLIC_REGISTRATION: whether public self-signup is permitted (default true)
ALLOW_PUBLIC_REGISTRATION=true
