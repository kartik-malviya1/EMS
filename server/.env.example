NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/attendance-system
JWT_SECRET=replace_with_a_very_secure_random_string_min_32_chars
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173

# Business rules
BUSINESS_TIMEZONE=Asia/Kolkata
STANDARD_SHIFT_MINUTES=480
WORKING_DAYS=1,2,3,4,5

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=attendance

# Geofence settings
GEOFENCE_ENABLED=false
GEOFENCE_OFFICE_LAT=28.6139
GEOFENCE_OFFICE_LNG=77.2090
GEOFENCE_RADIUS_METERS=200
GEOFENCE_MAX_ACCURACY_METERS=100

# Initial Admin Seeding
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123

# Scheduled Jobs
ENABLE_CRON=true
MISSED_PUNCH_IN_ALERT_TIME=11:00
MISSED_PUNCH_OUT_ALERT_TIME=20:00
AUTO_CLOSE_TIME=00:10
